; MW/0 schema, draft 1. Integer keys below are protocol assignments.
; Canonicalization and graph semantics are additional normative constraints.
mw0-object = task / claim / evidence / fact / assumption / delta / fail / attest / atom / predicate-def
cid = bstr .size 32
object-ref = [0..11, cid]
artifact-ref = [0, cid]
task-ref = [1, cid]
claim-ref = [2, cid]
evidence-ref = [3, cid]
assumption-ref = [5, cid]
atom-ref = [9, cid]
predicate-ref = [10, cid]
goal-ref = [11, cid]
u32 = 0..4294967295
i64 = -9223372036854775808..9223372036854775807
u64 = 0..18446744073709551615
decimal = [i64, i64]
scope = {0: goal-ref, 1: artifact-ref}
argument = [0, object-ref] / [1, tstr] / [2, i64] / [3, bool] / [4, decimal]
lineage = {0: tstr, 1: tstr, 2: tstr, 3: tstr}
pair = [tstr, tstr]
command = {
  0: [+ tstr], ; argv, ordered
  1: tstr, ; cwd
  2: [* pair], ; environment, set with unique names
  3: [+ pair], ; tool versions, set with unique names
  4: i64, ; exit code
  5: artifact-ref, ; stdout
  6: artifact-ref, ; stderr
  7: artifact-ref ; sandbox manifest
}
task = {0: 0, 1: 1, 2: {
  0: scope,
  1: [* object-ref], ; inputs, set
  2: [* tstr], ; capabilities, set
  3: [* assumption-ref], ; assumptions, set
  4: [* atom-ref], ; obligations, set
  5: artifact-ref, ; instruction
  6: 1..18446744073709551615, ; token budget
  7: 1..4294967295, ; call budget
  8: 1..18446744073709551615 ; time budget, ms
}}
claim = {0: 0, 1: 2, 2: {0: atom-ref, 1: bool, 2: scope}}
evidence = {0: 0, 1: 3, 2: deterministic-evidence / llm-evidence}
deterministic-evidence = {
  0: claim-ref, 1: scope, 2: 0..2, 3: 0,
  5: command, 6: artifact-ref, 7: [* tstr]
}
llm-evidence = {
  0: claim-ref, 1: scope, 2: 0..2, 3: 1,
  4: lineage, 6: artifact-ref, 7: [* tstr]
}
fact = {0: 0, 1: 4, 2: {
  0: claim-ref, 1: [+ evidence-ref],
  2: 800000 / 900000 / 950000 / 970000,
  3: "promotion-policy-v0", 4: [* assumption-ref]
}}
assumption = {0: 0, 1: 5, 2: {
  0: scope, 1: tstr, 2: tstr, 3: [+ tstr],
  4: artifact-ref, 5: [* artifact-ref], ? 6: assumption-ref
}}
delta = {0: 0, 1: 6, 2: {
  0: scope, 1: tstr, 2: artifact-ref, 3: artifact-ref,
  4: artifact-ref, 5: 0..1, 6: [* assumption-ref]
}}
fail = {0: 0, 1: 7, 2: {0: 0..6, 1: 0..12, 2: artifact-ref, ? 3: task-ref}}
attest = {0: 0, 1: 8, 2: {0: claim-ref, 1: task-ref, 2: tstr, 3: lineage}}
atom = {0: 0, 1: 9, 2: {0: predicate-ref, 1: [* argument]}}
predicate-def = {0: 0, 1: 10, 2: {
  0: tstr, 1: 1..4294967295, 2: [* 0..4], 3: tstr, 4: 0..3, ? 5: artifact-ref
}}
